# Copy to `.env` or `.env.local` and fill values. Next.js loads `.env` / `.env.local` automatically.

# --- PostgreSQL (required for DB features) ---
# Same connection string in one or both; Drizzle + scripts accept either name.
DATABASE_URL=postgresql://carepilot:carepilot@localhost:5433/carepilot
POSTGRES_DATABASE_URL=

# --- Optional: OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Optional: deep-link from agent KM cards to CARE (use {{code}} for KM code) ---
# NEXT_PUBLIC_CARE_KM_PROCEDURE_URL=https://care.example/km?procedure={{code}}

# --- CARE integration (MVP) ---
# CARE API default page size (sync paginates until all tickets are read; 0 = max 500/page)
CARE_API_LIST_LIMIT=100
CARE_API_PAGE_SIZE=100
CARE_API_TIMEOUT_MS=30000
CARE_API_BASE_URL=http://127.0.0.1:3000
# Background CARE → cp_agent sync (no UI). Set to 1 to disable.
# DISABLE_SYNC_SCHEDULER=1
SYNC_INTERVAL_MS=60000
# Max tickets per run to fetch history/comments (keeps sync under ~30s)
SYNC_DETAILS_BATCH=15
# Mark `running` sync logs older than this as failed (ms)
SYNC_STALE_LOG_MS=120000

# --- Optional: legacy carepilot AI sync batch size per POST /api/sync/care ---
CARE_SYNC_BATCH_LIMIT=80

# --- Optional: seed volume ---
# Legacy bulk seed volume (use db:seed:care-operational for MVP ingestion window)
SEED_TICKET_COUNT=70
GOLDEN_SEED_COUNT=48

# --- CarePilot local auth (`carepilot` schema users + sessions) ---
# Shared demo password for all seeded users (default: CarePilot2026!)
CAREPILOT_AUTH_SEED_PASSWORD=
# After `bun run db:seed:auth`:
#   Agent:  ikram.gafai@carrefour.internal
#   Admin:  khalid.as@carrefour.internal (owner)
#   Also:   thomas.mercier@carrefour.internal (Supervisor), elodie.petit@carrefour.internal (Admin)

# --- Agent workspace (`cp_agent` schema) ---
# Fresh install: `bun run db:init` (sql/init.sql) or `bun run db:create-tables` (ensure-care + drizzle-kit push).
# Agent queue only (`/agent/tickets`): `bun run db:ensure-cp-agent` then optional `bun run db:seed:cp-agent`.
# Drizzle Studio (https://local.drizzle.studio/) defaults to schema `public` (empty). Switch the schema
# dropdown to `cp_agent`, `carepilot`, or `care_source` to see CarePilot tables.
# Existing database created before cp_agent existed: `bun run db:ensure-cp-agent` (idempotent) or `bun run db:apply:cp-agent` then `bun run db:seed:cp-agent`.
