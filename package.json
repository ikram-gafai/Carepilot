    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "db:ping": "tsx scripts/db-ping.ts",
